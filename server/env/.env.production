NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-production-domain.com
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384
OLLAMA_MAX_ITERATIONS=8
OLLAMA_ENABLE_THINKING=true
OLLAMA_VERBOSE=true
DATA_DIR=./data/production
USE_MOCK_STAYS=true
USE_MOCK_FLIGHTS=true
USE_MOCK_CARS=true
# DB_ENCRYPTION_KEY, JWT_SECRET, DUFFEL_API_KEY are deliberately NOT set here — this file loads
# before the base .env (see config.ts), so a placeholder here would stop a real secret from
# either the base .env (local) or the container's actual environment (Docker) from ever
# taking effect. They must come only from the real environment, never from a tracked file.

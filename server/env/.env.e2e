NODE_ENV=e2e
PORT=3000
CORS_ORIGIN=http://localhost:4200
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384
OLLAMA_MAX_ITERATIONS=8
OLLAMA_ENABLE_THINKING=true
OLLAMA_VERBOSE=true
DATA_DIR=./data/e2e
USE_MOCK_STAYS=true
USE_MOCK_FLIGHTS=true
USE_MOCK_CARS=true
# DB_ENCRYPTION_KEY, JWT_SECRET, DUFFEL_API_KEY are deliberately NOT set here — same reasoning
# as .env.development/.env.production: this file loads before the base .env (see config.ts), so
# a placeholder here would stop a real secret from base .env from ever taking effect.

# Docker local mode's env-file (Compose's default — this file loads automatically for a plain
# `docker compose up`). Mocks are on for every vertical, so every secret below is an obviously-
# fake placeholder, safe to commit/push standalone. See .env.prod for the prod-mode equivalent,
# used via `docker compose --env-file .env.prod up` (or `npm run docker:prod`), and .env.dev for
# dev (`docker compose --env-file .env.dev up` / `npm run docker:dev`).

NODE_ENV=local

# Must stay identical to server/env/.env.local's value — npm run dev:local and a plain
# `docker compose up` both resolve to the same ./data/local database, and a mismatched key
# would fail to open it.
DB_ENCRYPTION_KEY=local-only-not-a-real-secret-safe-to-commit

# Must stay identical to server/env/.env.local's value, same reasoning as above.
JWT_SECRET=local-only-not-a-real-secret-safe-to-commit

# Never actually used — every USE_MOCK_* flag is true for this profile.
DUFFEL_API_KEY=not_required_in_mock_mode

CORS_ORIGIN=http://localhost
